# ---------------------------------------------------------------------------
# Every tool except the AI assistant run entirely in the browser, so none
# of these are needed for local development of any tool but the AI assistant. Copy to .env.local
# and fill in only what you need.
# ---------------------------------------------------------------------------

# Which LLM provider the shared-key path uses. One of: gemini | groq | cloudflare
AI_PROVIDER=gemini

# Server-only. Never referenced from client code, never committed.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hard ceiling on tokens generated per request, so one prompt cannot drain the quota.
AI_MAX_OUTPUT_TOKENS=1024

# Requests allowed per IP per minute against the shared key.
AI_RATE_LIMIT_PER_MINUTE=8

# Once the shared key has generated this many tokens in a UTC day, the app
# flips to bring-your-own-key for everyone until midnight.
AI_DAILY_TOKEN_BUDGET=2000000

# Set to "true" to disable the shared key entirely and require every user to
# supply their own. Public because the client needs it to render the UI.
NEXT_PUBLIC_BYOK_ONLY=false
